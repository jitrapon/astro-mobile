<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only manifest overlay. The manifest merger applies it to the debug build type alone, so the
  cleartext exemption it points at cannot reach a release build even by accident.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application android:networkSecurityConfig="@xml/network_security_config" />

</manifest>
